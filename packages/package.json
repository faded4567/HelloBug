{
  "name": "hellobug",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm --filter @hellobug/protocol build && pnpm --filter @hellobug/server build && pnpm --filter @hellobug/daemon build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:server": "pnpm --filter @hellobug/server dev",
    "dev:daemon": "pnpm --filter @hellobug/daemon dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.13",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
